{
  "apiVersion": 3,
  "name": "kuh/program-schedule",
  "version": "3.1.1",
  "title": "Bühnenplan",
  "category": "design",
  "icon": "schedule",
  "description": "Bühnenplan des Marktes: Zeitraster über alle Bühnen, Tages-Tabs und Auftritts-Übersicht pro Act. Die Daten kommen aus Programm → Programmpunkte.",
  "keywords": [
    "programm",
    "bühnenplan",
    "schedule",
    "zeitplan",
    "timetable",
    "bühne",
    "act"
  ],
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "anchor": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Bühnenplan"
    },
    "showTitle": {
      "type": "boolean",
      "default": true
    },
    "titleFont": {
      "type": "string",
      "default": "headline"
    },
    "defaultView": {
      "type": "string",
      "default": "grid"
    },
    "showNowMarker": {
      "type": "boolean",
      "default": true
    },
    "showActPanel": {
      "type": "boolean",
      "default": true
    },
    "pixelsPerHour": {
      "type": "number",
      "default": 120
    },
    "mapPath": {
      "type": "string",
      "default": "/karte"
    }
  },
  "textdomain": "korn-und-hansemarkt",
  "editorScript": "file:./editor.js",
  "render": "file:./render.php"
}
